{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "currentpulse-ai-kl7x.vercel.app"
        }
      ],
      "destination": "https://currentpulse-ai.vercel.app/$1",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/auto-publish", "schedule": "15 0 * * *" },
    { "path": "/api/process-queue", "schedule": "15 2 * * *" },
    { "path": "/api/process-queue", "schedule": "15 4 * * *" },
    { "path": "/api/auto-publish", "schedule": "15 6 * * *" },
    { "path": "/api/process-queue", "schedule": "15 8 * * *" },
    { "path": "/api/process-queue", "schedule": "15 10 * * *" },
    { "path": "/api/auto-publish", "schedule": "15 12 * * *" },
    { "path": "/api/process-queue", "schedule": "15 14 * * *" },
    { "path": "/api/process-queue", "schedule": "15 16 * * *" },
    { "path": "/api/auto-publish", "schedule": "15 18 * * *" },
    { "path": "/api/process-queue", "schedule": "15 20 * * *" },
    { "path": "/api/process-queue", "schedule": "15 22 * * *" }
  ]
}
